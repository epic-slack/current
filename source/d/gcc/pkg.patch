diff --git a/gcc.SlackBuild b/gcc.SlackBuild
index 57fbf0b..df21a0c 100644
--- a/gcc.SlackBuild
+++ b/gcc.SlackBuild
@@ -69,7 +69,11 @@ BUILD=${BUILD:-2}
 
 # Which compilers do we want to build?
 if [ -z $LANGS ]; then
-  LANGS="ada,c,c++,d,fortran,go,lto,m2,objc,obj-c++,rust"
+  if [ "$(uname -m)" = "ia64" ]; then
+    LANGS="c,c++,fortran"
+  else
+    LANGS="ada,c,c++,d,fortran,go,lto,m2,objc,obj-c++,rust"
+  fi
   # Add COBOL on supported $ARCH:
   if [ "$(uname -m)" = "x86_64" -o "$(uname -m)" = "aarch64" ]; then
     LANGS="${LANGS},cobol"
@@ -101,6 +105,8 @@ fi
 # Using it elsewhere will break the build.
 if [ "$ARCH" = "x86_64" -a ! -r /lib/ld-linux.so.2 ]; then
   MULTILIB=${MULTILIB:-"--disable-multilib"}
+elif [ "$ARCH" = "ia64" ]; then
+  MULTILIB=${MULTILIB:-"--disable-multilib"}
 else
   MULTILIB=${MULTILIB:-"--enable-multilib"}
 fi
@@ -115,12 +121,14 @@ if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
     echo "gcc-gcobol-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz"
   fi
   echo "gcc-gfortran-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz"
+  if [ "$ARCH" != "ia64" ]; then
   echo "gcc-gnat-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz"
   echo "gcc-objc-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz"
   echo "gcc-go-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz"
   echo "gcc-gdc-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz"
   echo "gcc-gm2-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz"
   echo "gcc-rust-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz"
+  fi
   exit 0
 fi
 
@@ -132,6 +140,10 @@ elif [ "$ARCH" = "x86_64" ]; then
   SLKCFLAGS="-O2 -march=x86-64 -mtune=generic -fPIC"
   LIBDIRSUFFIX="64"
   LIB_ARCH=amd64
+elif [ "$ARCH" = "ia64" ]; then
+  SLKCFLAGS="-O2 -fPIC"
+  LIBDIRSUFFIX=""
+  LIB_ARCH=ia64
 else
   SLKCFLAGS="-O2"
   LIBDIRSUFFIX=""
@@ -157,6 +169,7 @@ PKG1=$TMP/package-gcc
 # These are the directories to build other packages in:
 PKG2=$TMP/package-gcc-g++
 PKG3=$TMP/package-gcc-gfortran
+if [ "$ARCH" != "ia64" ]; then
 PKG4=$TMP/package-gcc-gnat
 PKG6=$TMP/package-gcc-objc
 PKG8=$TMP/package-gcc-go
@@ -164,16 +177,25 @@ PKG10=$TMP/package-gcc-gdc
 PKG11=$TMP/package-gcc-gm2
 PKG12=$TMP/package-gcc-rust
 PKG13=$TMP/package-gcc-gcobol
+fi
 
 # Clear the build locations:
+if [ "$ARCH" != "ia64" ]; then
 rm -rf $PKG{1,2,3,4,6,8,10,11,12,13}
 mkdir -p $PKG{1,2,3,4,6,8,10,11,12,13}/usr/doc/gcc-$VERSION
+else
+rm -rf $PKG{1,2,3}
+mkdir -p $PKG{1,2,3}/usr/doc/gcc-$VERSION
+fi
 
 # Insert package descriptions:
+if [ "$ARCH" != "ia64" ]; then
 mkdir -p $PKG{1,2,3,4,6,8,9,10,11,12,13}/install
+fi
 cat $CWD/slack-desc.gcc > $PKG1/install/slack-desc
 cat $CWD/slack-desc.gcc-g++ > $PKG2/install/slack-desc
 cat $CWD/slack-desc.gcc-gfortran > $PKG3/install/slack-desc
+if [ "$ARCH" != "ia64" ]; then
 cat $CWD/slack-desc.gcc-gnat > $PKG4/install/slack-desc
 cat $CWD/slack-desc.gcc-objc > $PKG6/install/slack-desc
 cat $CWD/slack-desc.gcc-go > $PKG8/install/slack-desc
@@ -181,6 +203,7 @@ cat $CWD/slack-desc.gcc-gdc > $PKG10/install/slack-desc
 cat $CWD/slack-desc.gcc-gm2 > $PKG11/install/slack-desc
 cat $CWD/slack-desc.gcc-rust > $PKG12/install/slack-desc
 cat $CWD/slack-desc.gcc-gcobol > $PKG13/install/slack-desc
+fi
 
 cd gcc-$SRCVER || exit 1
 
@@ -244,6 +267,7 @@ mkdir -p $PKG3/usr/doc/gcc-${VERSION}/gcc/fortran
   fi
 )
 
+if [ "$ARCH" != "ia64" ]; then
 mkdir -p $PKG4/usr/doc/gcc-${VERSION}/gcc/ada
 ( cd gcc/ada || exit 0
   cp -a \
@@ -330,6 +354,7 @@ mkdir -p $PKG13/usr/doc/gcc-${VERSION}/gcc/cobol
     touch -r ChangeLog $PKG13/usr/doc/gcc-${VERSION}/gcc/cobol/ChangeLog
   fi
 )
+fi
 
 mkdir -p $PKG3/usr/doc/gcc-${VERSION}/libgfortran
 ( cd libgfortran || exit 0
@@ -339,6 +364,7 @@ mkdir -p $PKG3/usr/doc/gcc-${VERSION}/libgfortran
   fi
 )
 
+if [ "$ARCH" != "ia64" ]; then
 mkdir -p $PKG4/usr/doc/gcc-${VERSION}/libada
 ( cd libada || exit 0
   if [ -r ChangeLog ]; then
@@ -346,6 +372,7 @@ mkdir -p $PKG4/usr/doc/gcc-${VERSION}/libada
     touch -r ChangeLog $PKG4/usr/doc/gcc-${VERSION}/libada/ChangeLog
   fi
 )
+fi
 
 mkdir -p $PKG1/usr/doc/gcc-${VERSION}/libgomp
 ( cd libgomp || exit 0
@@ -355,6 +382,7 @@ mkdir -p $PKG1/usr/doc/gcc-${VERSION}/libgomp
   fi
 )
   
+if [ "$ARCH" != "ia64" ]; then
 mkdir -p $PKG6/usr/doc/gcc-${VERSION}/libobjc
 ( cd libobjc || exit 0
   if [ -r ChangeLog ]; then
@@ -365,6 +393,7 @@ mkdir -p $PKG6/usr/doc/gcc-${VERSION}/libobjc
     README* THREADS* \
   $PKG6/usr/doc/gcc-${VERSION}/libobjc
 )
+fi
     
 mkdir -p $PKG2/usr/doc/gcc-${VERSION}/libstdc++-v3
 ( cd libstdc++-v3 || exit 0
@@ -382,8 +411,12 @@ mkdir -p $PKG2/usr/doc/gcc-${VERSION}/libstdc++-v3
 ( mkdir gcc.build.lnx
   cd gcc.build.lnx
 
+  GCC_LTO="--enable-lto"
   if [ "$ARCH" = "x86_64" ]; then
     GCC_ARCHOPTS="--with-arch=x86-64"
+  elif [ "$ARCH" = "ia64" ]; then
+    GCC_ARCHOPTS=""
+    GCC_LTO="--disable-lto"
   else
     GCC_ARCHOPTS="--with-arch=$ARCH"
   fi
@@ -409,7 +442,7 @@ mkdir -p $PKG2/usr/doc/gcc-${VERSION}/libstdc++-v3
      --enable-gnu-indirect-function \
      --enable-gnu-unique-object \
      --enable-plugin \
-     --enable-lto \
+     $GCC_LTO \
      --disable-install-libiberty \
      --disable-werror \
      --with-gnu-ld \
@@ -429,6 +462,14 @@ mkdir -p $PKG2/usr/doc/gcc-${VERSION}/libstdc++-v3
   # Include all debugging info (for now):
   make $NUMJOBS bootstrap || exit 1
 
+  # save build dir for later make check!
+  pushd ../../
+  echo "# Saving bootstrapped build dir..."
+  tar -cf "gcc-$SRCVER-bootstrapped.tar" "gcc-$SRCVER"
+  echo "# Saved to: $PWD/gcc-$SRCVER-bootstrapped.tar"
+  popd
+
+  if [ "$ARCH" != "ia64" ]; then
   ( cd gcc
     make $NUMJOBS gnatlib GNATLIBCFLAGS="$SLKCFLAGS" || exit 1
     # This wants a shared -ladd2line?
@@ -438,6 +479,7 @@ mkdir -p $PKG2/usr/doc/gcc-${VERSION}/libstdc++-v3
     CXXFLAGS="$SLKCFLAGS" \
     make $NUMJOBS gnattools || exit 1
   ) || exit 1
+  fi
   make info || exit 1
 
   # Set GCCCHECK=something to run the tests
@@ -604,6 +646,7 @@ fi
   fi
 )
 
+if [ "$ARCH" != "ia64" ]; then
 # gcc-gnat:
 ( cd $PKG4
   mkdir -p usr/bin
@@ -771,6 +814,7 @@ if echo $LANGS | grep -q cobol ; then
     mv $PKG1/usr/share/gcobol usr/share
   )
 fi
+fi
 
 # Generate packages:
 ( cd $PKG1
@@ -779,6 +823,7 @@ fi
   /sbin/makepkg -l y -c n $TMP/gcc-g++-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz )
 ( cd $PKG3
   /sbin/makepkg -l y -c n $TMP/gcc-gfortran-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz )
+if [ "$ARCH" != "ia64" ]; then
 ( cd $PKG4
   /sbin/makepkg -l y -c n $TMP/gcc-gnat-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz )
 ( cd $PKG6
@@ -791,6 +836,7 @@ fi
   /sbin/makepkg -l y -c n $TMP/gcc-gm2-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz )
 ( cd $PKG12
   /sbin/makepkg -l y -c n $TMP/gcc-rust-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz )
+fi
 if echo $LANGS | grep -q cobol ; then
   ( cd $PKG13
     /sbin/makepkg -l y -c n $TMP/gcc-gcobol-${VERSION}${VERTAG}-$ARCH-${BUILD}${TAG}.txz )
