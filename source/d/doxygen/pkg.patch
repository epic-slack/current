diff --git a/doxygen.SlackBuild b/doxygen.SlackBuild
index 1434c76..2d94eb5 100644
--- a/doxygen.SlackBuild
+++ b/doxygen.SlackBuild
@@ -52,6 +52,9 @@ if [ "$ARCH" = "i686" ]; then
 elif [ "$ARCH" = "x86_64" ]; then
   SLKCFLAGS="-O2 -march=x86-64 -mtune=generic -fPIC"
   LIBDIRSUFFIX="64"
+elif [ "$ARCH" = "ia64" ]; then
+  SLKCFLAGS="-O2 -fPIC"
+  LIBDIRSUFFIX=""
 else
   SLKCFLAGS="-O2"
   LIBDIRSUFFIX=""
@@ -77,6 +80,10 @@ find . \
 # tabularray.sty causes it to fail. Perhaps we'll look into adding that to
 # TeXLive.
 
+# Patch CMakeLists.txt to avoid an LTO build
+# see https://github.com/doxygen/doxygen/issues/11890
+patch -p1 < $CWD/disable-lto-build.patch || exit 1
+
 mkdir build
 cd build
   cmake \
@@ -92,7 +98,7 @@ cd build
     -Dbuild_doc=OFF \
     -Dbuild_parse=ON \
     -Dbuild_search=ON \
-    -Dbuild_wizard=ON \
+    -Dbuild_wizard=OFF \
     -Dbuild_xmlparser=ON \
     -Duse_sqlite3=ON \
     -G "Unix Makefiles" .. || exit 1
