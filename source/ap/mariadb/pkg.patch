diff --git a/mariadb.SlackBuild b/mariadb.SlackBuild
index a279ee4..a3548e4 100644
--- a/mariadb.SlackBuild
+++ b/mariadb.SlackBuild
@@ -78,6 +78,9 @@ if [ "$ARCH" = "i686" ]; then
 elif [ "$ARCH" = "x86_64" ]; then
   SLKCFLAGS="-O2 -march=x86-64 -mtune=generic -fPIC"
   LIBDIRSUFFIX="64"
+elif [ "$ARCH" = "ia64" ]; then
+  SLKCFLAGS="-O2 -fPIC"
+  LIBDIRSUFFIX=""
 else
   SLKCFLAGS="-O2"
   LIBDIRSUFFIX=""
@@ -102,6 +105,22 @@ find . \
 # be started with /etc/rc.d/rc.mysqld, not a systemd service file:
 cat $CWD/mariadb-install-db.no.systemd.instructions.diff | patch -p1 --verbose || exit 1
 
+# Apply build fix for ia64
+#
+# Otherwise we get:
+# ```
+# CMake Error:
+#  Error evaluating generator expression:
+#
+#    $<:-Wno-missing-declarations>
+#
+#  Expression did not evaluate to a known generator expression
+# ```
+# ...3 times since 11.8.7
+if [ "$ARCH" = "ia64" ]; then
+  cat $CWD/mariadb-11.8.7-build-fix.patch | patch -p1 --verbose || exit 1
+fi
+
 mkdir build
 cd build
 cmake \
@@ -157,6 +176,25 @@ rm -rf $PKG/etc/systemd
 # Leave build directory:
 cd ..
 
+# move `/usr/lib64/*` to `/usr/lib` for ia64, if existing
+if [ "$ARCH" = "ia64" ]; then
+  if [ -d $PKG/usr/lib64 ]; then
+    if [ -d $PKG/usr/lib ]; then
+      mv $PKG/usr/lib64/* $PKG/usr/lib/ && rm -rf $PKG/usr/lib64
+    else
+      mv $PKG/usr/lib64 $PKG/usr/lib
+    fi
+  fi
+# also do that similarly for `/lib64`, if existing
+  if [ -d $PKG/lib64 ]; then
+    if [ -d $PKG/lib ]; then
+      mv $PKG/lib64/* $PKG/lib/ && rm -rf $PKG/lib64
+    else
+      mv $PKG/lib64 $PKG/lib
+    fi
+  fi
+fi
+
 # Install innotop
 install -m755 debian/additions/innotop/innotop $PKG/usr/bin/
 install -m644 debian/additions/innotop/innotop.1 $PKG/usr/man/man1/
